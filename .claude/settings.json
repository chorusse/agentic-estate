{
  "permissions": {
    "deny": [
      "Read(knowledge/quarantine/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-policy.sh"
          }
        ]
      }
    ]
  }
}
